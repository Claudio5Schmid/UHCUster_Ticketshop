# Copy to .env.local and fill in real values. Never commit .env.local (it's gitignored).
# Names only here - see docs/ARCHITECTURE.md #5 for what each one is for.

# --- Phase 1 (this phase): Supabase connection ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3 addition: automatic schedule sync from Swiss Unihockey ---
# REQUIRED for /api/sync/swissunihockey to run at all - without it the route refuses
# every request, Vercel's own cron included, and the schedule simply stops updating.
# It used to be optional, which meant an unset variable removed the protection rather
# than applying it, leaving a public endpoint that wrote to the database.
# Vercel sends it back as `Authorization: Bearer <value>` on the scheduled request
# once the variable exists on the project. Any long random string will do
# (`openssl rand -hex 32`).
# CRON_SECRET=

# --- Phase 4: spam protection on the order form ---
# Currently set to Cloudflare's public test keys in .env.local (always pass) -
# replace with your own Turnstile site's keys before going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Phase 6: ticket tokens and wallet passes ---
# TICKET_TOKEN_SECRET=   # required - any 32+ byte random hex string (e.g. `openssl rand -hex 32`)

# Apple Wallet and Google Wallet: neither is built this phase (docs/DECISIONS.md D28).
# Both need an issuer/developer account Claudio would have to apply for - Apple's is
# slow (paid program, certificates), Google's needs a Business Console issuer account
# plus a pre-created pass class. Every ticket already gets a fully functional PDF
# regardless. Revisit Google first once an issuer account exists to actually test
# against - these names are reserved for that follow-up, no code reads them yet.
# APPLE_WALLET_PASS_TYPE_ID=
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_CERTIFICATE=
# APPLE_WALLET_CERTIFICATE_PASSWORD=
# APPLE_WALLET_WWDR_CERTIFICATE=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_ID=

# --- Customer order links (docs/DECISIONS.md D54) ---
# Signs /meine-tickets links, which let a customer see their order status and
# download their ticket PDFs without an account. A third, separate secret on
# purpose - a different security domain than ticket tokens or scanner sessions.
# ORDER_LINK_SECRET=   # required - any 32+ byte random hex string (e.g. `openssl rand -hex 32`)

# --- Phase 7: scanner PWA ---
# SCANNER_SESSION_SECRET=   # required - any 32+ byte random hex string, separate from TICKET_TOKEN_SECRET

# --- Outbound email (Resend, since 2026-09-09 - was Amazon SES before that):
# the two deliberate, scoped exceptions to "no email anywhere"
# (docs/DECISIONS.md) - membership card PDFs from /admin/members, and the order
# confirmation after checkout. Nothing else sends mail. ---
# RESEND_API_KEY=   # required - from resend.com > API Keys, sending permission is enough
#
# MAIL_FROM_EMAIL must be an address on a domain verified in Resend, with the DKIM
# records Resend issues present in that domain's DNS (e.g. tickets@uhcuster.ch) - NOT a
# free-mail address. Mail claiming to be from gmail.com/gmx/bluewin can never pass SPF
# or DKIM alignment for that domain, so receivers drop it silently even though the
# provider reports the send as successful. See docs/DECISIONS.md D49.
# MAIL_FROM_EMAIL=
#
# Optional: where replies go, if MAIL_FROM_EMAIL is a no-reply address. The order
# confirmation tells customers they can reply, so this should reach a real mailbox.
# MAIL_REPLY_TO=

# --- Order notifications to the office (migration brief §2.4) ---
# Where the "Neue Bestellung ... - Rechnung erstellen" mail goes after a shop
# order: the treasurer / accounting mailbox. Unset = nobody is told (logged).
# ORDER_NOTIFICATION_EMAIL=

# --- Canonical site URL ---
# Used for absolute links that leave the app - today the order link in the
# confirmation e-mail. Falls back to Vercel's production URL, then localhost, so
# local development works without it; set it in production so the link in a
# customer's inbox always points at the real domain.
# NEXT_PUBLIC_SITE_URL=
